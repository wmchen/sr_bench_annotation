{
  "name": "realisr-remote-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "NODE_PATH=./node_modules NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test",
    "generate:api": "openapi-typescript ../openapi.json -o src/api/generated.ts",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "konva": "^10.0.0",
    "react-konva": "^19.0.10"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.1"
  }
}
